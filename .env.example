# Локально: скопируйте в .env.local и подставьте значения из Supabase → Project Settings → API
#
# Vercel: Settings → Environment Variables — те же имена для Production; после изменений сделайте Redeploy
# (переменные подставляются при npm run build).
#
REACT_APP_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your_supabase_anon_key

# Шторка входа на весь сайт. Если обе переменные заданы — без логина сайт не откроется.
# Если не заданы, шторка не показывается (удобно для локальной разработки).
REACT_APP_SITE_LOGIN=vip
REACT_APP_SITE_PASSWORD=change-this-password
